# ------------------------------------------------------------------------------
# .gitconfig — Global Git configuration
# ------------------------------------------------------------------------------
# What it does:
#   Sets user name/email, default branch (main), core.pager (delta), and
#   difftool/mergetool to Neovim. Delta styles diff output; LFS and hub/github
#   sections for large files and GitHub CLI.
#
# How to interact:
#   Edit in repo (git-configs/.gitconfig). Symlink: ~/.gitconfig → repo.
#   Use: git diff (uses delta); git difftool (opens nvim -d); git mergetool (nvim 3-way).
#   Ensure nvim and delta are on PATH when running git.
#
# Author: Casey A. Luna 
# Location: ~/.gitconfig (symlinked from repo)
# ------------------------------------------------------------------------------

[user]
  name = caseyluna
  email = caseyluna25@gmail.com

[init]
  defaultBranch = main

[core]
  excludesfile = ~/.gitignore_global
  autocrlf = false
  eol = lf
  pager = delta

[github]
  user = caseyluna

[hub]
  protocol = https

# ------------------------------------------------------------------------------
# 🧪 Diffs & Difftools
# ------------------------------------------------------------------------------

[diff]
  tool = nvimdiff
  colorMoved = default

[difftool]
  prompt = false

[difftool "nvimdiff"]
  cmd = nvim -d "$LOCAL" "$REMOTE"
  # Use nvim from PATH (portable across macOS/Linux; ensure nvim is installed)
  path = nvim

# ------------------------------------------------------------------------------
# 🧠 Merge Tools
# ------------------------------------------------------------------------------

[merge]
  conflictstyle = diff3

[mergetool "nvimdiff"]
  cmd = nvim -d "$LOCAL" "$MERGED" "$REMOTE" -c '$wincmd w' -c 'wincmd J'
  trustExitCode = true

# ------------------------------------------------------------------------------
# 🧩 Git LFS
# ------------------------------------------------------------------------------

[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true

# ------------------------------------------------------------------------------
# 🎨 Delta for Pretty Diffs
# ------------------------------------------------------------------------------

[interactive]
  diffFilter = delta --color-only

[delta]
  navigate = true        # Enable n/N navigation between diff hunks
  light = false          # Set to true for light backgrounds

[color]
  ui = true

[color "diff-highlight"]
  oldNormal    = red bold
  oldHighlight = red bold 52
  newNormal    = green bold
  newHighlight = green bold 22

[color "diff"]
  meta       = 11
  frag       = magenta bold
  func       = 146 bold
  commit     = yellow bold
  old        = red bold
  new        = green bold
  whitespace = red reverse
# Push over SSH, clone/fetch over HTTPS — a fresh Mac has no SSH key yet, and
# setup.sh / lazy.nvim / TPM clone https://github.com/… URLs.
[url "git@github.com:"]
	pushInsteadOf = https://github.com/
